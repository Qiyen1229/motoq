# 複製為 .env 後依需求修改（docker compose 會自動讀取）

# 預設最高權限管理員帳號與密碼（首次啟動自動建立）
MOTOQ_DEFAULT_ADMIN_USERNAME=qiyen
# 請自行設定一組強密碼;留空則不會自動建立管理員
MOTOQ_DEFAULT_ADMIN_PASSWORD=

# 若直接使用 NAS 內網 IP 或 HTTP 連線，請保持 false；
# 若前面有 HTTPS 反向代理（如 Synology 反向代理伺服器、Nginx Proxy Manager），請設為 true。
MOTOQ_COOKIE_SECURE=false

# 初始註冊防護碼（非必填；已設定預設管理員時一般不需要）
MOTOQ_SETUP_TOKEN=

# 登入 session 有效天數（管理員可在後台調整，此為初始值）
MOTOQ_SESSION_DAYS=30
# 登入失敗限流：視窗內最多失敗幾次（初始值，可在後台調整）
MOTOQ_LOGIN_MAX_FAILURES=5
MOTOQ_LOGIN_WINDOW_SECONDS=600

# 對外埠號（NAS host 端）
MOTOQ_PORT=9155


